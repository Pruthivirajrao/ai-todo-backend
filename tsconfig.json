{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",   //! It tells TS that My source code is inside src
    "outDir": "./dist",  //! It means Compiled js will be inside dist folder 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}